# Build + sign + upload to TestFlight, entirely in CI (no Mac exists on this team).
# Auth is the App Store Connect API key only — no Apple ID password, no 2FA.
default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: "fastlane/AuthKey.p8",
    )

    # Required on CI, and its absence does not fail loudly: without a temporary
    # unlocked keychain, match imports the signing identity into the login
    # keychain and codesign then BLOCKS on a GUI authorisation prompt that no
    # one can answer. The job burns its whole timeout looking like a slow build.
    setup_ci

    match(type: "appstore", api_key: api_key)

    # Never hardcode the profile name. When a capability changes on the App ID,
    # Apple invalidates the existing profile and refuses to reuse its name, so
    # match creates one called "match AppStore <bundle> <digits>". A hardcoded
    # name then fails with "No profile for team ... matching ... found" even
    # though a perfectly good profile was just installed. match publishes the
    # real name here; use it.
    app_id = "com.orimipuy.hakalkalan"
    profile_name = ENV.fetch("sigh_#{app_id}_appstore_profile-name")

    build_number = ENV.fetch("GITHUB_RUN_NUMBER", "1")

    # Injected here rather than committed: the repo holds no API keys.
    #
    # 🔴 A missing key used to be a warning. It is now fatal, because the
    # fallback it triggers is no longer merely a downgrade: without the key the
    # app signs in through /connect in a sheet, and that page carries a Google
    # button. Guideline 4.8 is only out of scope while the app offers no
    # third-party login service at all, and guideline 4 already refused the
    # sheet once. A build like that must never reach TestFlight.
    firebase_api_key = ENV.fetch("FIREBASE_API_KEY", "")
    if firebase_api_key.empty?
      UI.user_error!("FIREBASE_API_KEY is not set. Refusing to build: the app would " \
                     "fall back to browser sign-in, which App Review has rejected.")
    end

    gym(
      project: "Hakalkalan.xcodeproj",
      scheme: "Hakalkalan",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Hakalkalan.ipa",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} " \
              "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')} " \
              "FIREBASE_API_KEY='#{firebase_api_key}' " \
              "PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'",
      export_options: {
        provisioningProfiles: {
          app_id => profile_name,
        },
      },
    )

    pilot(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
